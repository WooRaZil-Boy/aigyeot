<?xml version="1.0" encoding="utf-8"?>
<!-- debug 빌드 전용: 녹음 파일을 감지 파이프라인에 넣어 로그를 찍는 길(기기 회귀). 사용자 앱 화면이 아니라 adb로만 연다.
     평문 HTTP는 로컬 중계(wrangler dev)와 Virtual Console만 허용한다. release는 HTTPS·WSS만. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".detect.DetectReplayActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- 3D 실측: adb로만 연다 -->
        <activity
            android:name=".car3d.Car3dSpikeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- 홈 무대 그리기(칩·지시선 포함) 화면 대조: adb로만 연다 -->
        <activity
            android:name=".car3d.Car3dStageActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
