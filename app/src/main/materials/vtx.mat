// 단색(미리 곱하지 않은 색 + 알파), 꼭짓점 색을 곱함. 컴파일: matc -p mobile -a opengl -o assets/materials/vtx.filamat vtx.mat (Filament 1.77.3)
material {
    name : vtx,
    shadingModel : unlit,
    blending : transparent,
    doubleSided : true,
    depthWrite : false,
    requires : [ color ],
    parameters : [ { type : float4, name : color } ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = materialParams.color; c *= getColor();
        material.baseColor = vec4(c.rgb * c.a, c.a);
    }
}
