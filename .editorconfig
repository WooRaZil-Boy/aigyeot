root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts,swift}]
max_line_length = 160

[*.{ts,json,jsonc,yml,yaml,sh,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# 줄바꿈 문자가 시험 대상이거나 도구가 정하는 파일
[*.{csv,bat,pbxproj}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
